# `python dev.py setup` copia este archivo a backend/.env (con un JWT_SECRET aleatorio).
# Nunca subir el archivo .env al repositorio.

# Local: SQLite (un archivo, sin instalar nada). Producción: PostgreSQL, por ejemplo
# DATABASE_URL=postgresql+psycopg2://cafe:cafe@localhost:5432/cafe_jaen
DATABASE_URL=sqlite:///./cafe_jaen.db
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
SESSION_DAYS=30
CONSENT_VERSION=2026-10

# Factor local sobre la cotización internacional (diferencial y rendimiento). 1 = sin ajuste
LOCAL_PRICE_FACTOR=1

# Precio mundial en vivo (HU02, HU03). Webs disponibles: yahoo, stooq (y demo, solo sin internet)
QUOTATION_SOURCES=["yahoo","stooq"]
STOOQ_TIMEZONE=Europe/Warsaw
SOURCE_MAX_DEVIATION=0.01
MAX_QUOTE_CHANGE=0.10
# Horario de la bolsa de Nueva York (hora de Nueva York)
MARKET_OPENS=04:15
MARKET_CLOSES=13:30
STALE_AFTER_MINUTES=20

# «¿Vendo ahora o espero?» (HU05). El acierto sale de `make backtest`
SELLING_THRESHOLD=0.03
# SELLING_HIT_RATE_PCT=  (p. ej., 58.4; dejar comentado hasta tener el resultado)

# Asesor: "keyword" (sin internet ni costo) o "anthropic" (LLM real)
LLM_PROVIDER=keyword
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-5-5

SCHEDULER_ENABLED=true
# Ciclo de cierre (hora de Lima, después del cierre de la bolsa)
DAILY_CYCLE_TIME=14:05
CORS_ORIGINS=["http://localhost:5173"]
